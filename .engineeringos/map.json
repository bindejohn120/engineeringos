    {
      "id": "df-primary",
      "name": "Primary Request Flow",
      "description": "A developers request travels through the clean-architecture layers.",
      "steps": [
        {
          "step": "Request received",
          "from": "api",
          "to": "authn",
          "data": "request + credentials"
        },
        {
          "step": "Capability executed",
          "from": "api",
          "to": "app-map-generation",
          "data": "map generation"
        },
        {
          "step": "Next capability executed",
          "from": "api",
          "to": "app-mental-model-generation",
          "data": "mental model generation"
        },
        {
          "step": "Next capability executed",
          "from": "api",
          "to": "app-guardrail-enforcement",
          "data": "guardrail enforcement"
        },
        {
          "step": "Next capability executed",
          "from": "api",
          "to": "app-context-retrieval",
          "data": "context retrieval"
        },
        {
          "step": "Next capability executed",
          "from": "api",
          "to": "app-drift-detection",
          "data": "drift detection"
        },
        {
          "step": "Next capability executed",
          "from": "api",
          "to": "app-impact-analysis",
          "data": "impact analysis"
        },
        {
          "step": "Next capability executed",
          "from": "api",
          "to": "app-verification",
          "data": "verification"
        },
        {
          "step": "Response returned",
          "from": "api",
          "data": "result envelope"
        }
      ]
    }
